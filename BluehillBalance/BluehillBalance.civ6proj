    <FrontEndActionData><![CDATA[<FrontEndActions><UpdateDatabase id="BluehillBalance_ConfigData"><File>Data/ConfigData.xml</File></UpdateDatabase><UpdateText id="BluehillBalance_ConfigText"><File Priority="2">Text/RemoveConfigText.xml</File><File>Text/ConfigText_en_US.xml</File><File>Text/ConfigText_ko_KR.xml</File></UpdateText></FrontEndActions>]]></FrontEndActionData>
    <InGameActionData><![CDATA[<InGameActions><UpdateDatabase id="BluehillBalance_Database"><File>Data/Beliefs.xml</File><File>Data/Buildings.xml</File><File>Data/Civilizations.xml</File><File>Data/Districts.xml</File><File>Data/DistrictsBuildings.sql</File><File>Data/Eras.xml</File><File>Data/GlobalParameters.xml</File><File>Data/Governments.xml</File><File>Data/GreatPeople_Admirals.xml</File><File>Data/GreatPeople_Engineers.xml</File><File>Data/GreatPeople_Generals.xml</File><File>Data/GreatPeople_Scientists.xml</File><File>Data/Improvements.xml</File><File>Data/Leaders.xml</File><File>Data/Moments.xml</File><File>Data/Policies.xml</File><File>Data/Resources.xml</File><File>Data/Technologies.xml</File><File>Data/UnitAbilities.xml</File><File>Data/Units.xml</File><File Priority="-1">Data/Units_XP2.sql</File></UpdateDatabase><UpdateText id="BluehillBalance_Text"><File Priority="2">Text/RemoveConfigText.xml</File><File Priority="2">Text/RemoveText.xml</File><File>Text/ConfigText_en_US.xml</File><File>Text/ConfigText_ko_KR.xml</File><File>Text/Text_en_US.xml</File><File>Text/Text_ko_KR.xml</File></UpdateText><UpdateIcons id="BluehillBalance_Icons"><File>Data/Icons.xml</File></UpdateIcons><AddGameplayScripts id="BluehillBalance_GameplayScripts"><File>Scripts/Comandante.lua</File><File>Scripts/SteelAutoWalls.lua</File></AddGameplayScripts><UpdateDatabase id="BluehillBalance_SecretSocieties_Database"><Criteria>BluehillBalance_SecretSocieties</Criteria><File>Data/Districts_SecretSocieties_MODE.xml</File></UpdateDatabase></InGameActions>]]></InGameActionData>
    <ActionCriteriaData><![CDATA[<ActionCriteria><Criteria id="BluehillBalance_SecretSocieties"><RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse><ConfigurationValueMatches><ConfigurationId>GAMEMODE_SECRETSOCIETIES</ConfigurationId><Group>Game</Group><Value>1</Value></ConfigurationValueMatches></Criteria></ActionCriteria>]]></ActionCriteriaData>
